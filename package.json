{
  "name": "duifarm-pro",
  "private": true,
  "type": "module",
  "description": "Quản lý trang trại Dúi (web tĩnh, chạy trên trình duyệt)",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "dev": "wrangler dev --port 8787",
    "db:local": "wrangler d1 execute farmdui65 --local --file=db/schema.sql",
    "db:remote": "wrangler d1 execute farmdui65 --remote --file=db/schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.159.0"
  }
}
